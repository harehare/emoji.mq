# Alias shortcode -> canonical shortcode (well-known alternate spellings).
def _emoji_aliases():
  {
    "+1": "thumbsup",
    "-1": "thumbsdown",
    "satisfied": "laughing",
    "simple_smile": "slight_smile",
    "victory": "v",
    "raised_hand_with_fingers_splayed": "raised_hand",
  }
end

def _emoji_reverse_table():
  fold(entries(_emoji_table()), dict(), fn(acc, kv): set(acc, kv[1], kv[0]);)
end

def _emoji_strip_colons(s):
  ltrimstr(rtrimstr(to_string(s), ":"), ":")
end

def _emoji_lookup_alias(name):
  let aliases = _emoji_aliases()
  | if (has(aliases, name)): _emoji_table()[aliases[name]] else: None
end

# Looks up the emoji for a shortcode. Accepts the name with or without
# surrounding colons (e.g. "fire" or ":fire:") and resolves aliases
# (e.g. "+1" -> "thumbsup"). Returns None if the shortcode is unknown.
def emoji_for(shortcode):
  let name = _emoji_strip_colons(shortcode)
  | let table = _emoji_table()
  | if (has(table, name)): table[name] else: _emoji_lookup_alias(name)
end

# Looks up the canonical shortcode for an emoji character. Returns None
# if the emoji isn't in the table.
def shortcode_for(e):
  let table = _emoji_reverse_table()
  | if (has(table, e)): table[e] else: None
end

# Returns all known canonical shortcode names, sorted.
def shortcodes():
  sort(keys(_emoji_table()))
end

# Replaces every recognized `:shortcode:` in a string with its emoji.
# Unrecognized `:word:` patterns are left untouched.
def to_emoji(text):
  let s = to_string(text)
  | fold(uniq(scan(s, ":[a-zA-Z0-9_+-]+:")), s, fn(acc, m):
      let e = emoji_for(m)
      | if (is_none(e)): acc else: replace(acc, m, e)
    ;)
end

# Replaces every recognized emoji character in a string with its
# canonical `:shortcode:`.
def to_shortcode(text):
  let s = to_string(text)
  | fold(entries(_emoji_table()), s, fn(acc, kv):
      if (contains(acc, kv[1])): replace(acc, kv[1], ":" + kv[0] + ":") else: acc
    ;)
end

# Returns true if the string contains a recognized shortcode or emoji.
def has_emoji(text):
  let s = to_string(text)
  | any(uniq(scan(s, ":[a-zA-Z0-9_+-]+:")), fn(m): !is_none(emoji_for(m));) ||
    any(values(_emoji_table()), fn(e): contains(s, e);)
end

# Removes every recognized shortcode and emoji character from a string,
# collapsing the extra spaces left behind.
def strip(text):
  let s = to_string(text)
  | let s1 = fold(uniq(scan(s, ":[a-zA-Z0-9_+-]+:")), s, fn(acc, m):
      if (is_none(emoji_for(m))): acc else: replace(acc, m, "")
    ;)
  | let s2 = fold(values(_emoji_table()), s1, fn(acc, e): replace(acc, e, "");)
  | trim(gsub(s2, "[ \t]+", " "))
end

# Conventional Commits type -> gitmoji (https://gitmoji.dev), matching the
# emoji-prefixed commit convention (feat, fix, docs, style, refactor, perf,
# test, build, ci, chore, revert, init).
def _gitmoji_table():
  {
    "feat": "✨",
    "fix": "🐛",
    "docs": "📝",
    "style": "💄",
    "refactor": "♻️",
    "perf": "⚡",
    "test": "✅",
    "build": "📦",
    "ci": "👷",
    "chore": "🔧",
    "revert": "⏪",
    "init": "🎉",
  }
end

# Returns the gitmoji conventionally associated with a Conventional Commits
# type, or None if the type is unrecognized.
def gitmoji(commit_type):
  let table = _gitmoji_table()
  | if (has(table, commit_type)): table[commit_type] else: None
end
